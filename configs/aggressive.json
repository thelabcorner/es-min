{
  "comment": "Aggressive profile: only for source verified free of eval/with/indirect-eval and after passing the fixture corpus + production smoke tests in Illustrator. Built from the option matrix: every option below passed individually on the sensitive corpus; combinations are only 'safe' when the corpus passes as a whole (run the harness to confirm).",
  "_id": "aggressive",
  "parse": { "module": false, "html5_comments": false },
  "compress": {
    "arguments": false,
    "arrows": false,
    "awaits": false,
    "rests": false,
    "spreads": false,
    "templates": false,
    "keep_fargs": true,
    "keep_fnames": false,
    "typeofs": false,
    "passes": 2,
    "unsafe": false,
    "unsafe_comps": false,
    "unsafe_Function": false,
    "unsafe_math": false,
    "unsafe_proto": false,
    "unsafe_regexp": false,
    "unsafe_undefined": false,
    "collapse_vars": true,
    "conditionals": true,
    "dead_code": true,
    "evaluate": true,
    "hoist_funs": true,
    "hoist_props": true,
    "hoist_vars": false,
    "if_return": true,
    "inline": 1,
    "join_vars": true,
    "loops": true,
    "merge_vars": true,
    "negate_iife": true,
    "properties": false,
    "pure_getters": false,
    "reduce_funcs": true,
    "reduce_vars": true,
    "sequences": 20,
    "side_effects": true,
    "switches": true,
    "unused": true
  },
  "mangle": {
    "toplevel": false,
    "eval": false,
    "keep_fnames": false,
    "keep_fargs": true,
    "reserved": [
      "$",
      "app",
      "documents",
      "File",
      "Folder",
      "BridgeTalk",
      "ExternalObject",
      "ScriptUI",
      "Window",
      "UnitValue",
      "Socket",
      "System",
      "XML",
      "XMLList",
      "Namespace",
      "QName",
      "alert",
      "confirm",
      "prompt",
      "SaveOptions",
      "UserInteractionLevel",
      "JSON"
    ]
  },
  "output": {
    "extendscript": true,
    "semicolons": true,
    "braces": true,
    "ascii_only": true,
    "keep_quoted_props": true,
    "quote_keys": true,
    "quote_style": 3,
    "inline_script": false,
    "comments": false
  }
}
