{
  "_id": "matrix-compress",
  "comment": "Compress-option isolation matrix. Each variant enables exactly one compression transform on top of an all-false compress profile, so failures are attributable to a single option. unsafe_* variants are tested on a restricted fixture subset by the harness (see --matrix-subset).",
  "_base": {
    "compress": false,
    "mangle": false,
    "output": {
      "extendscript": true,
      "semicolons": true,
      "braces": true,
      "ascii_only": true,
      "keep_quoted_props": true,
      "quote_keys": true,
      "quote_style": 3
    }
  },
  "_compress_base": {
    "arguments": false,
    "assignments": false,
    "arrows": false,
    "awaits": false,
    "booleans": false,
    "collapse_vars": false,
    "comparisons": false,
    "conditionals": false,
    "dead_code": false,
    "directives": false,
    "evaluate": false,
    "functions": false,
    "hoist_funs": false,
    "hoist_props": false,
    "hoist_vars": false,
    "if_return": false,
    "inline": false,
    "join_vars": false,
    "keep_fargs": true,
    "keep_fnames": false,
    "loops": false,
    "merge_vars": false,
    "negate_iife": false,
    "objects": false,
    "passes": 1,
    "properties": false,
    "pure_getters": false,
    "reduce_funcs": false,
    "reduce_vars": false,
    "rests": false,
    "sequences": false,
    "side_effects": false,
    "spreads": false,
    "strings": false,
    "switches": false,
    "templates": false,
    "typeofs": false,
    "unsafe": false,
    "unsafe_comps": false,
    "unsafe_Function": false,
    "unsafe_math": false,
    "unsafe_proto": false,
    "unsafe_regexp": false,
    "unsafe_undefined": false,
    "unused": false
  },
  "variants": [
    { "_id": "compress-none", "opts": {} },
    { "_id": "compress-arguments", "opts": { "compress": { "arguments": true } } },
    { "_id": "compress-assignments", "opts": { "compress": { "assignments": true } } },
    { "_id": "compress-booleans", "opts": { "compress": { "booleans": true } } },
    { "_id": "compress-collapse-vars", "opts": { "compress": { "collapse_vars": true } } },
    { "_id": "compress-comparisons", "opts": { "compress": { "comparisons": true } } },
    { "_id": "compress-conditionals", "opts": { "compress": { "conditionals": true } } },
    { "_id": "compress-dead-code", "opts": { "compress": { "dead_code": true } } },
    { "_id": "compress-directives", "opts": { "compress": { "directives": true } } },
    { "_id": "compress-evaluate", "opts": { "compress": { "evaluate": true } } },
    { "_id": "compress-functions", "opts": { "compress": { "functions": true } } },
    { "_id": "compress-hoist-funs", "opts": { "compress": { "hoist_funs": true } } },
    { "_id": "compress-hoist-props", "opts": { "compress": { "hoist_props": true } } },
    { "_id": "compress-hoist-vars", "opts": { "compress": { "hoist_vars": true } } },
    { "_id": "compress-if-return", "opts": { "compress": { "if_return": true } } },
    { "_id": "compress-inline", "opts": { "compress": { "inline": true } } },
    { "_id": "compress-join-vars", "opts": { "compress": { "join_vars": true } } },
    { "_id": "compress-loops", "opts": { "compress": { "loops": true } } },
    { "_id": "compress-merge-vars", "opts": { "compress": { "merge_vars": true } } },
    { "_id": "compress-negate-iife", "opts": { "compress": { "negate_iife": true } } },
    { "_id": "compress-objects", "opts": { "compress": { "objects": true } } },
    { "_id": "compress-properties", "opts": { "compress": { "properties": true } } },
    { "_id": "compress-pure-getters", "opts": { "compress": { "pure_getters": true } } },
    { "_id": "compress-reduce-funcs", "opts": { "compress": { "reduce_funcs": true } } },
    { "_id": "compress-reduce-vars", "opts": { "compress": { "reduce_vars": true } } },
    { "_id": "compress-sequences", "opts": { "compress": { "sequences": true } } },
    { "_id": "compress-side-effects", "opts": { "compress": { "side_effects": true } } },
    { "_id": "compress-strings", "opts": { "compress": { "strings": true } } },
    { "_id": "compress-switches", "opts": { "compress": { "switches": true } } },
    { "_id": "compress-typeofs", "opts": { "compress": { "typeofs": true } } },
    { "_id": "compress-unused", "opts": { "compress": { "unused": true } } },
    { "_id": "compress-passes-2", "opts": { "compress": { "passes": 2 } } },
    { "_id": "compress-keep-fargs-false", "opts": { "compress": { "keep_fargs": false } } },
    { "_id": "compress-unsafe", "opts": { "compress": { "unsafe": true } }, "unsafeSubset": true },
    { "_id": "compress-unsafe-math", "opts": { "compress": { "unsafe_math": true } }, "unsafeSubset": true },
    { "_id": "compress-unsafe-comps", "opts": { "compress": { "unsafe_comps": true } }, "unsafeSubset": true },
    { "_id": "compress-unsafe-proto", "opts": { "compress": { "unsafe_proto": true } }, "unsafeSubset": true },
    { "_id": "compress-unsafe-undefined", "opts": { "compress": { "unsafe_undefined": true } }, "unsafeSubset": true },
    { "_id": "compress-unsafe-Function", "opts": { "compress": { "unsafe_Function": true } }, "unsafeSubset": true },
    { "_id": "compress-unsafe-regexp", "opts": { "compress": { "unsafe_regexp": true } }, "unsafeSubset": true }
  ]
}
